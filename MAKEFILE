# ModiCom - Borland C++ 3.1 makefile
#
# Build from the repository root inside DOS (for example, DOSBox):
#
#       MAKE
#       MAKE clean
#
# Sources are read from SRC and objects and MODICOM.EXE are written
# to BUILD.  Compiler options are held in MODICOM.CFG.  Adjust
# BORLANDC below if Borland C++ is not installed in C:\BORLANDC.

.AUTODEPEND

.SUFFIXES: .EXE .OBJ .ASM .C
.PATH.c   = SRC
.PATH.obj = BUILD

BORLANDC = C:\BORLANDC

CC    = BCC +MODICOM.CFG
TASM  = TASM
TLINK = TLINK

INCLUDEPATH = SRC;$(BORLANDC)\INCLUDE
LIBPATH     = $(BORLANDC)\LIB

CFLAGS = -I$(INCLUDEPATH) -L$(LIBPATH) -nBUILD
AFLAGS = /MX /ZI /O
LFLAGS = /v /x /c /P- /L$(LIBPATH)

OBJS = MODICOM.OBJ EDITOR.OBJ STATUS.OBJ NAVIGATE.OBJ EDIT.OBJ FILEIO.OBJ SEARCH.OBJ KEYBOARD.OBJ STRINGS.OBJ VIDEO.OBJ

all: BUILD\MODICOM.EXE

BUILD\MODICOM.EXE: $(OBJS)
	@if not exist BUILD\NUL md BUILD
	$(TLINK) $(LFLAGS) @&&|
C0S.OBJ+
BUILD\MODICOM.OBJ+
BUILD\EDITOR.OBJ+
BUILD\STATUS.OBJ+
BUILD\NAVIGATE.OBJ+
BUILD\EDIT.OBJ+
BUILD\FILEIO.OBJ+
BUILD\SEARCH.OBJ+
BUILD\KEYBOARD.OBJ+
BUILD\STRINGS.OBJ+
BUILD\VIDEO.OBJ
BUILD\MODICOM
		# no map file
GRAPHICS.LIB+
CS.LIB
|

# Compile rules

.c.obj:
	@if not exist BUILD\NUL md BUILD
	$(CC) $(CFLAGS) -c $<

VIDEO.OBJ: SRC\VIDEO.ASM MAKEFILE
	@if not exist BUILD\NUL md BUILD
	-del BUILD\VIDEO.OBJ
	$(TASM) $(AFLAGS) SRC\VIDEO.ASM,BUILD\VIDEO.OBJ

clean:
	-del BUILD\MODICOM.EXE
	-del BUILD\*.OBJ

rebuild: clean all
