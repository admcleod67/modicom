# ModiCom tests - Borland C++ 3.1 makefile
#
# Build and run from the repository root inside DOS (for example,
# DOSBox):
#
#       MAKE -f TESTS\TESTS.MAK rebuild
#       BUILD\TESTS\TSTRINGS
#       BUILD\TESTS\TEDITIO
#       BUILD\TESTS\TEDITNAV
#       BUILD\TESTS\TEDITEDT
#       BUILD\TESTS\TEDITIN
#       BUILD\TESTS\TVIDEO
#
# This makefile is intentionally separate from the production
# MAKEFILE. It writes only to BUILD\TESTS and does not contribute
# any object files to BUILD\MODICOM.EXE. Adjust BORLANDC below if
# Borland C++ is not installed in C:\BORLANDC.

.AUTODEPEND

BORLANDC = C:\BORLANDC

CC    = BCC +MODICOM.CFG
TASM  = TASM
TLINK = TLINK

INCLUDEPATH = SRC;TESTS;$(BORLANDC)\INCLUDE
LIBPATH     = $(BORLANDC)\LIB

CFLAGS = -I$(INCLUDEPATH) -L$(LIBPATH) -nBUILD\TESTS
AFLAGS = /MX /ZI /O
LFLAGS = /v /x /c /P- /L$(LIBPATH)

all: BUILD\TESTS\TSTRINGS.EXE BUILD\TESTS\TEDITIO.EXE BUILD\TESTS\TEDITNAV.EXE BUILD\TESTS\TEDITEDT.EXE BUILD\TESTS\TEDITIN.EXE BUILD\TESTS\TVIDEO.EXE

BUILD\TESTS\TSTRINGS.EXE: BUILD\TESTS\TSTRINGS.OBJ BUILD\TESTS\STRINGS.OBJ
	$(TLINK) $(LFLAGS) @&&|
C0S.OBJ+
BUILD\TESTS\TSTRINGS.OBJ+
BUILD\TESTS\STRINGS.OBJ
BUILD\TESTS\TSTRINGS
		# no map file
CS.LIB
|

BUILD\TESTS\TSTRINGS.OBJ: TESTS\TSTRINGS.C TESTS\TEST.H SRC\STRINGS.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c TESTS\TSTRINGS.C

BUILD\TESTS\STRINGS.OBJ: SRC\STRINGS.C SRC\STRINGS.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c SRC\STRINGS.C

BUILD\TESTS\TEDITIO.EXE: BUILD\TESTS\TEDITIO.OBJ BUILD\TESTS\THARNESS.OBJ BUILD\TESTS\TEXTEDIT.OBJ BUILD\TESTS\STATUS.OBJ BUILD\TESTS\NAVIGATE.OBJ BUILD\TESTS\BUFFEDIT.OBJ BUILD\TESTS\FILEIO.OBJ BUILD\TESTS\SEARCH.OBJ BUILD\TESTS\PROMPT.OBJ BUILD\TESTS\KEYBOARD.OBJ BUILD\TESTS\STRINGS.OBJ
	$(TLINK) $(LFLAGS) @&&|
C0S.OBJ+
BUILD\TESTS\TEDITIO.OBJ+
BUILD\TESTS\THARNESS.OBJ+
BUILD\TESTS\TEXTEDIT.OBJ+
BUILD\TESTS\STATUS.OBJ+
BUILD\TESTS\NAVIGATE.OBJ+
BUILD\TESTS\BUFFEDIT.OBJ+
BUILD\TESTS\FILEIO.OBJ+
BUILD\TESTS\SEARCH.OBJ+
BUILD\TESTS\PROMPT.OBJ+
BUILD\TESTS\KEYBOARD.OBJ+
BUILD\TESTS\STRINGS.OBJ
BUILD\TESTS\TEDITIO
		# no map file
CS.LIB
|

BUILD\TESTS\TEDITIO.OBJ: TESTS\TEDITIO.C TESTS\TEST.H TESTS\THARNESS.H SRC\EDITOR.H SRC\FILEIO.H SRC\STRINGS.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c TESTS\TEDITIO.C

BUILD\TESTS\THARNESS.OBJ: TESTS\THARNESS.C TESTS\THARNESS.H TESTS\TEST.H SRC\EDITOR.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c TESTS\THARNESS.C

BUILD\TESTS\TEXTEDIT.OBJ: SRC\TEXTEDIT.C SRC\EDITOR.H SRC\STATUS.H SRC\NAVIGATE.H SRC\BUFFEDIT.H SRC\FILEIO.H SRC\SEARCH.H SRC\KEYBOARD.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c SRC\TEXTEDIT.C

BUILD\TESTS\STATUS.OBJ: SRC\STATUS.C SRC\STATUS.H SRC\EDITOR.H SRC\KEYBOARD.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c SRC\STATUS.C

BUILD\TESTS\NAVIGATE.OBJ: SRC\NAVIGATE.C SRC\NAVIGATE.H SRC\EDITOR.H SRC\STRINGS.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c SRC\NAVIGATE.C

BUILD\TESTS\BUFFEDIT.OBJ: SRC\BUFFEDIT.C SRC\BUFFEDIT.H SRC\EDITOR.H SRC\NAVIGATE.H SRC\STRINGS.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c SRC\BUFFEDIT.C

BUILD\TESTS\FILEIO.OBJ: SRC\FILEIO.C SRC\FILEIO.H SRC\EDITOR.H SRC\STATUS.H SRC\PROMPT.H SRC\STRINGS.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c SRC\FILEIO.C

BUILD\TESTS\SEARCH.OBJ: SRC\SEARCH.C SRC\SEARCH.H SRC\PROMPT.H SRC\EDITOR.H SRC\STATUS.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c SRC\SEARCH.C

BUILD\TESTS\PROMPT.OBJ: SRC\PROMPT.C SRC\PROMPT.H SRC\KEYBOARD.H SRC\STRINGS.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c SRC\PROMPT.C

BUILD\TESTS\KEYBOARD.OBJ: SRC\KEYBOARD.C SRC\KEYBOARD.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c SRC\KEYBOARD.C

BUILD\TESTS\TEDITNAV.EXE: BUILD\TESTS\TEDITNAV.OBJ BUILD\TESTS\THARNESS.OBJ BUILD\TESTS\TEXTEDIT.OBJ BUILD\TESTS\STATUS.OBJ BUILD\TESTS\NAVIGATE.OBJ BUILD\TESTS\BUFFEDIT.OBJ BUILD\TESTS\FILEIO.OBJ BUILD\TESTS\SEARCH.OBJ BUILD\TESTS\PROMPT.OBJ BUILD\TESTS\KEYBOARD.OBJ BUILD\TESTS\STRINGS.OBJ
	$(TLINK) $(LFLAGS) @&&|
C0S.OBJ+
BUILD\TESTS\TEDITNAV.OBJ+
BUILD\TESTS\THARNESS.OBJ+
BUILD\TESTS\TEXTEDIT.OBJ+
BUILD\TESTS\STATUS.OBJ+
BUILD\TESTS\NAVIGATE.OBJ+
BUILD\TESTS\BUFFEDIT.OBJ+
BUILD\TESTS\FILEIO.OBJ+
BUILD\TESTS\SEARCH.OBJ+
BUILD\TESTS\PROMPT.OBJ+
BUILD\TESTS\KEYBOARD.OBJ+
BUILD\TESTS\STRINGS.OBJ
BUILD\TESTS\TEDITNAV
		# no map file
CS.LIB
|

BUILD\TESTS\TEDITNAV.OBJ: TESTS\TEDITNAV.C TESTS\TEST.H TESTS\THARNESS.H SRC\EDITOR.H SRC\NAVIGATE.H SRC\STRINGS.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c TESTS\TEDITNAV.C

BUILD\TESTS\TEDITEDT.EXE: BUILD\TESTS\TEDITEDT.OBJ BUILD\TESTS\THARNESS.OBJ BUILD\TESTS\TEXTEDIT.OBJ BUILD\TESTS\STATUS.OBJ BUILD\TESTS\NAVIGATE.OBJ BUILD\TESTS\BUFFEDIT.OBJ BUILD\TESTS\FILEIO.OBJ BUILD\TESTS\SEARCH.OBJ BUILD\TESTS\PROMPT.OBJ BUILD\TESTS\KEYBOARD.OBJ BUILD\TESTS\STRINGS.OBJ
	$(TLINK) $(LFLAGS) @&&|
C0S.OBJ+
BUILD\TESTS\TEDITEDT.OBJ+
BUILD\TESTS\THARNESS.OBJ+
BUILD\TESTS\TEXTEDIT.OBJ+
BUILD\TESTS\STATUS.OBJ+
BUILD\TESTS\NAVIGATE.OBJ+
BUILD\TESTS\BUFFEDIT.OBJ+
BUILD\TESTS\FILEIO.OBJ+
BUILD\TESTS\SEARCH.OBJ+
BUILD\TESTS\PROMPT.OBJ+
BUILD\TESTS\KEYBOARD.OBJ+
BUILD\TESTS\STRINGS.OBJ
BUILD\TESTS\TEDITEDT
		# no map file
CS.LIB
|

BUILD\TESTS\TEDITEDT.OBJ: TESTS\TEDITEDT.C TESTS\TEST.H TESTS\THARNESS.H SRC\EDITOR.H SRC\BUFFEDIT.H SRC\STRINGS.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c TESTS\TEDITEDT.C

BUILD\TESTS\TEDITIN.EXE: BUILD\TESTS\TEDITIN.OBJ BUILD\TESTS\TEXTEDIT.OBJ BUILD\TESTS\STATUS.OBJ BUILD\TESTS\NAVIGATE.OBJ BUILD\TESTS\BUFFEDIT.OBJ BUILD\TESTS\FILEIO.OBJ BUILD\TESTS\SEARCH.OBJ BUILD\TESTS\PROMPT.OBJ BUILD\TESTS\KEYBOARD.OBJ BUILD\TESTS\STRINGS.OBJ
	$(TLINK) $(LFLAGS) @&&|
C0S.OBJ+
BUILD\TESTS\TEDITIN.OBJ+
BUILD\TESTS\TEXTEDIT.OBJ+
BUILD\TESTS\STATUS.OBJ+
BUILD\TESTS\NAVIGATE.OBJ+
BUILD\TESTS\BUFFEDIT.OBJ+
BUILD\TESTS\FILEIO.OBJ+
BUILD\TESTS\SEARCH.OBJ+
BUILD\TESTS\PROMPT.OBJ+
BUILD\TESTS\KEYBOARD.OBJ+
BUILD\TESTS\STRINGS.OBJ
BUILD\TESTS\TEDITIN
		# no map file
CS.LIB
|

BUILD\TESTS\TEDITIN.OBJ: TESTS\TEDITIN.C TESTS\TEST.H SRC\EDITOR.H SRC\KEYBOARD.H SRC\PROMPT.H SRC\SEARCH.H SRC\STRINGS.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c TESTS\TEDITIN.C

BUILD\TESTS\TVIDEO.EXE: BUILD\TESTS\TVIDEO.OBJ BUILD\TESTS\VIDEO.OBJ
	$(TLINK) $(LFLAGS) @&&|
C0S.OBJ+
BUILD\TESTS\TVIDEO.OBJ+
BUILD\TESTS\VIDEO.OBJ
BUILD\TESTS\TVIDEO
		# no map file
CS.LIB
|

BUILD\TESTS\TVIDEO.OBJ: TESTS\TVIDEO.C TESTS\TEST.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c TESTS\TVIDEO.C

BUILD\TESTS\VIDEO.OBJ: SRC\VIDEO.ASM
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	-del BUILD\TESTS\VIDEO.OBJ
	$(TASM) $(AFLAGS) SRC\VIDEO.ASM,BUILD\TESTS\VIDEO.OBJ

clean:
	-del BUILD\TESTS\TSTRINGS.EXE
	-del BUILD\TESTS\TEDITIO.EXE
	-del BUILD\TESTS\TEDITNAV.EXE
	-del BUILD\TESTS\TEDITEDT.EXE
	-del BUILD\TESTS\TEDITIN.EXE
	-del BUILD\TESTS\TVIDEO.EXE
	-del BUILD\TESTS\*.OBJ

rebuild: clean all
