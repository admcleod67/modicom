# ModiCom tests - Borland C++ 3.1 makefile
#
# Build and run from the repository root inside DOS (for example,
# DOSBox):
#
#       MAKE -f TESTS\TESTS.MAK rebuild
#       BUILD\TESTS\TSTRINGS
#       BUILD\TESTS\TEDITIO
#       BUILD\TESTS\TEDITOPS
#       BUILD\TESTS\TEDITIN
#       BUILD\TESTS\TVIDEO
#
# This makefile is intentionally separate from the production
# MAKEFILE. It writes only to BUILD\TESTS and does not contribute
# any object files to BUILD\MODICOM.EXE. Adjust BORLANDC below if
# Borland C++ is not installed in C:\BORLANDC.

.AUTODEPEND

BORLANDC = C:\BORLANDC

CC    = BCC +MODICOM.CFG
TASM  = TASM
TLINK = TLINK

INCLUDEPATH = $(BORLANDC)\INCLUDE;SRC;TESTS
LIBPATH     = $(BORLANDC)\LIB

CFLAGS = -I$(INCLUDEPATH) -L$(LIBPATH) -nBUILD\TESTS
AFLAGS = /MX /ZI /O
LFLAGS = /v /x /c /P- /L$(LIBPATH)

all: BUILD\TESTS\TSTRINGS.EXE BUILD\TESTS\TEDITIO.EXE BUILD\TESTS\TEDITOPS.EXE BUILD\TESTS\TEDITIN.EXE BUILD\TESTS\TVIDEO.EXE

BUILD\TESTS\TSTRINGS.EXE: BUILD\TESTS\TSTRINGS.OBJ BUILD\TESTS\STRINGS.OBJ
	$(TLINK) $(LFLAGS) @&&|
C0S.OBJ+
BUILD\TESTS\TSTRINGS.OBJ+
BUILD\TESTS\STRINGS.OBJ
BUILD\TESTS\TSTRINGS
		# no map file
CS.LIB
|

BUILD\TESTS\TSTRINGS.OBJ: TESTS\TSTRINGS.C TESTS\TEST.H SRC\STRINGS.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c TESTS\TSTRINGS.C

BUILD\TESTS\STRINGS.OBJ: SRC\STRINGS.C SRC\STRINGS.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c SRC\STRINGS.C

BUILD\TESTS\TEDITIO.EXE: BUILD\TESTS\TEDITIO.OBJ BUILD\TESTS\EDITOR.OBJ BUILD\TESTS\KEYBOARD.OBJ BUILD\TESTS\STRINGS.OBJ
	$(TLINK) $(LFLAGS) @&&|
C0S.OBJ+
BUILD\TESTS\TEDITIO.OBJ+
BUILD\TESTS\EDITOR.OBJ+
BUILD\TESTS\KEYBOARD.OBJ+
BUILD\TESTS\STRINGS.OBJ
BUILD\TESTS\TEDITIO
		# no map file
CS.LIB
|

BUILD\TESTS\TEDITIO.OBJ: TESTS\TEDITIO.C TESTS\TEST.H SRC\EDITOR.H SRC\STRINGS.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c TESTS\TEDITIO.C

BUILD\TESTS\EDITOR.OBJ: SRC\EDITOR.C SRC\EDITOR.H SRC\KEYBOARD.H SRC\STRINGS.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c SRC\EDITOR.C

BUILD\TESTS\KEYBOARD.OBJ: SRC\KEYBOARD.C SRC\KEYBOARD.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c SRC\KEYBOARD.C

BUILD\TESTS\TEDITOPS.EXE: BUILD\TESTS\TEDITOPS.OBJ BUILD\TESTS\EDITOR.OBJ BUILD\TESTS\KEYBOARD.OBJ BUILD\TESTS\STRINGS.OBJ
	$(TLINK) $(LFLAGS) @&&|
C0S.OBJ+
BUILD\TESTS\TEDITOPS.OBJ+
BUILD\TESTS\EDITOR.OBJ+
BUILD\TESTS\KEYBOARD.OBJ+
BUILD\TESTS\STRINGS.OBJ
BUILD\TESTS\TEDITOPS
		# no map file
CS.LIB
|

BUILD\TESTS\TEDITOPS.OBJ: TESTS\TEDITOPS.C TESTS\TEST.H SRC\EDITOR.H SRC\STRINGS.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c TESTS\TEDITOPS.C

BUILD\TESTS\TEDITIN.EXE: BUILD\TESTS\TEDITIN.OBJ BUILD\TESTS\EDITOR.OBJ BUILD\TESTS\KEYBOARD.OBJ BUILD\TESTS\STRINGS.OBJ
	$(TLINK) $(LFLAGS) @&&|
C0S.OBJ+
BUILD\TESTS\TEDITIN.OBJ+
BUILD\TESTS\EDITOR.OBJ+
BUILD\TESTS\KEYBOARD.OBJ+
BUILD\TESTS\STRINGS.OBJ
BUILD\TESTS\TEDITIN
		# no map file
CS.LIB
|

BUILD\TESTS\TEDITIN.OBJ: TESTS\TEDITIN.C TESTS\TEST.H SRC\EDITOR.H SRC\KEYBOARD.H SRC\STRINGS.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c TESTS\TEDITIN.C

BUILD\TESTS\TVIDEO.EXE: BUILD\TESTS\TVIDEO.OBJ BUILD\TESTS\VIDEO.OBJ
	$(TLINK) $(LFLAGS) @&&|
C0S.OBJ+
BUILD\TESTS\TVIDEO.OBJ+
BUILD\TESTS\VIDEO.OBJ
BUILD\TESTS\TVIDEO
		# no map file
CS.LIB
|

BUILD\TESTS\TVIDEO.OBJ: TESTS\TVIDEO.C TESTS\TEST.H SRC\VIDEO.H MODICOM.CFG
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	$(CC) $(CFLAGS) -c TESTS\TVIDEO.C

BUILD\TESTS\VIDEO.OBJ: SRC\VIDEO.ASM
	@if not exist BUILD\NUL md BUILD
	@if not exist BUILD\TESTS\NUL md BUILD\TESTS
	-del BUILD\TESTS\VIDEO.OBJ
	$(TASM) $(AFLAGS) SRC\VIDEO.ASM,BUILD\TESTS\VIDEO.OBJ

clean:
	-del BUILD\TESTS\TSTRINGS.EXE
	-del BUILD\TESTS\TEDITIO.EXE
	-del BUILD\TESTS\TEDITOPS.EXE
	-del BUILD\TESTS\TEDITIN.EXE
	-del BUILD\TESTS\TVIDEO.EXE
	-del BUILD\TESTS\*.OBJ

rebuild: clean all
